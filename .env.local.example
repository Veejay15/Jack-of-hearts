# Pusher Channels (https://pusher.com/channels) — server-side
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=us2

# Pusher — client-side (must duplicate the values above with NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=us2

# Upstash Redis (https://upstash.com/) — REST credentials
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Random secret used to HMAC-sign player tokens. Generate with: openssl rand -hex 32
APP_SECRET=
